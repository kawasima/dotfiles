[user]
	email = kawasima1016@gmail.com
	name = kawasima
[push]
	default = simple
[alias]
	st = status
	ci = commit
	co = checkout

[include]
	path = .gitconfig.proxy

[url "https://"]
	instedOf = git://
[include]
	path = .gitconfig.local
[init]
	defaultBranch = main
[core]
	autocrlf = input
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
